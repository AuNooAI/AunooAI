# AunooAI Environment Configuration Example
# Copy this file to .env and configure your settings

# PostgreSQL Password (for docker-compose)
POSTGRES_PASSWORD=changeme

# PgAdmin Password (optional, only if using --profile admin)
PGADMIN_PASSWORD=admin

# Admin Password (for SQLite instances)
ADMIN_PASSWORD=admin

# Build Information (optional)
APP_VERSION=dev
GIT_BRANCH=main
BUILD_DATE=2025-01-01

# Signing keys (REQUIRED - the app refuses to start without them)
# These sign the session cookie and the auth tokens. There is deliberately no
# fallback: a default committed to the repo lets anyone forge a login.
# Generate each one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
FLASK_SECRET_KEY=
NORN_SECRET_KEY=

# First-run admin bootstrap (optional).
# Set this on a brand-new deployment with no admin account, log in once as
# admin with this password, change the password when prompted, then remove it.
# Leave blank and there is no bootstrap path at all.
AUNOO_BOOTSTRAP_ADMIN_PASSWORD=

# API Keys (REQUIRED - Add your keys here)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
FIRECRAWL_API_KEY=
NEWSAPI_KEY=
ELEVENLABS_API_KEY=

# Other API Keys (optional)
NEWSDATA_API_KEY=
THENEWSAPI_KEY=
GEMINI_API_KEY=

# Server Configuration (auto-configured in Docker)
# PORT=10015
# DOMAIN=localhost
# ENVIRONMENT=development
