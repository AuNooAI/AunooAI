    "agents": {
        "power": {
            "model": "gpt-4.1-mini",
            "temperature": 0.3,
            "max_tokens": 4000,
            "prompt_file": "pam_power_agent.md"
        },
        "attention": {
            "model": "gpt-4.1-mini",
            "temperature": 0.3,
            "max_tokens": 4000,
            "prompt_file": "pam_attention_agent.md"
        },
        "money": {
            "model": "gpt-4.1-mini",
            "temperature": 0.3,
            "max_tokens": 4000,
            "prompt_file": "pam_money_agent.md"
        },
        "trends": {
            "model": "gpt-4.1-mini",
            "temperature": 0.3,
            "max_tokens": 3000,
            "prompt_file": "pam_trend_agent.md"
        },
        "synthesis": {
            "model": "gpt-4.1",
            "temperature": 0.4,
            "max_tokens": 5000,
            "prompt_file": "pam_synthesis_agent.md"
        }
    },

    "external_data": {
        "semantic_scholar": {
            "enabled": true,
            "used_by": ["attention"],
            "rate_limit": 100,
            "cache_ttl_hours": 24
        },
        "google_search": {
            "enabled": true,
            "used_by": ["power", "money"],
            "rate_limit": 95,
            "cache_ttl_hours": 24
        },
        "crunchbase": {
            "enabled": false,
            "used_by": ["money"],
            "requires_api_key": true
        }
    },

    "trend_calculator": {
        "weights": {
            "article_volume": 0.25,
            "recency": 0.20,
            "source_authority": 0.20,
            "velocity": 0.20,
            "external_signals": 0.15
        },
        "normalization": {
            "article_count_baseline": 20,
            "article_count_max": 100
        },
        "velocity_thresholds": {
            "accelerating": 20,
            "decelerating": -15
        }
    },

    "score_calculation": {
        "pillar_weights": {
            "power": 0.35,
            "attention": 0.35,
            "money": 0.30
        },
        "threat_levels": {
            "critical": 80,
            "high": 70,
            "elevated": 55,
            "moderate": 40
        }
    },

    "scenarios_2030": {
        "S1": {
            "name": "Trusted Ecosystem",
            "regulation": "high",
            "concentration": "low",
            "base_probability": 20
        },
        "S2": {
            "name": "Fragmented Compliance",
            "regulation": "high",
            "concentration": "high",
            "base_probability": 25
        },
        "S3": {
            "name": "Open Chaos",
            "regulation": "low",
            "concentration": "low",
            "base_probability": 15
        },
        "S4": {
            "name": "Behemoth Control",
            "regulation": "low",
            "concentration": "high",
            "base_probability": 40
        }
    }
